# ─────────────────────────────────────────────────────────────────────────────
# LEARN AI WITH ME — ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in the values from your Supabase project.
# NEVER commit `.env` to version control. It is already listed in .gitignore.
#
# To get these values:
#   1. Create a free Supabase project at https://supabase.com
#   2. Go to: Project Settings → API
#   3. Copy the "Project URL" → VITE_SUPABASE_URL
#   4. Copy the "anon / public" key → VITE_SUPABASE_PUBLISHABLE_KEY
#
# WARNING: Do NOT use the service_role or secret key here.
# Only the anon / public key is safe to expose in browser code.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Override the base URL for local development (used by Vite)
# ─────────────────────────────────────────────────────────────────────────────
# VITE_BASE_URL=http://localhost:5173
